<odoo>

    <!-- Maintenance Management List View -->

    <record id="maintenance_management_list" model="ir.ui.view">
        <field name="name">maintenance.management.list</field>
        <field name="model">maintenance.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="home_property_id"/>
                <field name="property_type"/>
                <field name="owner_id"/>
                <field name="city"/>
                <field name="area" optional="hide"/>
                <field name="request_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <!-- Maintenance Management Form View -->
    <record id="maintenance_management_form" model="ir.ui.view">
        <field name="name">maintenance.management.form</field>
        <field name="model">maintenance.management</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="home_property_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Maintenance">
                            <group string="Property Information">
                                <field name="property_type" readonly="1"/>
                                <field name="owner_id" readonly="1"/>
                                <field name="street" readonly="1"/>
                                <field name="city" readonly="1"/>
                                <field name="area" readonly="1"/>
                            </group>
                            <group string="Maintenance Requests">
                                <field name="request_count" readonly="1"/>
                            </group>
                            <group string="Notes">
                                <field name="notes" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Maintenance Management Action -->
    <record id="maintenance_management_action" model="ir.actions.act_window">
        <field name="name">Maintenance Management</field>
        <field name="res_model">maintenance.management</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

