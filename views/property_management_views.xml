
<odoo>

    <!-- ===================================================== -->
    <!-- Real Estate List View -->
    <!-- ===================================================== -->

    <record id="property_management_list" model="ir.ui.view">
        <field name="name">property.management.list</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_id"/>
                <field name="property_state"/>
                <field name="selling_price"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- Real Estate Form View -->
    <!-- ===================================================== -->

    <record id="property_management_form" model="ir.ui.view">
        <field name="name">property.management.form</field>
        <field name="model">property.management</field>
        <field name="arch" type="xml">

            <form>
                <sheet>
                    <!-- General Information -->
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <!-- ================================================= -->
                    <!-- Real Estate -->
                    <!-- ================================================= -->
                    <notebook>
                        <page string="Real Estate">
                            <!-- Property Information -->
                            <group string="Property Information">
                                <field name="property_id"/>
                                <field name="property_ref" readonly="1"/>
                                <field name="property_state" readonly="1"/>
                            </group>
                            <!-- Financial Information -->
                            <group string="Financial Information">
                                <field name="expected_price" readonly="1"/>
                                <field name="selling_price" readonly="1"/>
                                <field name="property_diff" readonly="1"/>
                            </group>
                            <!-- Property Details -->
                            <group string="Property Details">
                                <field name="bedroom" readonly="1"/>
                                <field name="living_area" readonly="1"/>
                                <field name="facades" readonly="1"/>
                                <field name="garage" readonly="1"/>
                                <field name="garden" readonly="1"/>
                                <field name="garden_area" readonly="1"/>
                            </group>

                            <!-- Owner Information -->
                            <group string="Owner">
                                <field name="owner_id" readonly="1"/>
                                <field name="owner_phone" readonly="1"/>
                                <field name="owner_address" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- Action -->
    <!-- ===================================================== -->

    <record id="property_management_action" model="ir.actions.act_window">
        <field name="name">Property Management</field>
        <field name="res_model">property.management</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

